<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) system splash screen, Dark Mode off. The app is
         always dark, so light and dark mode share the same splash.
         splash_icon is a 288 dp canvas whose skull (glow included) fits the
         192 dp circle; see tool/art/render_icons.py and docs/ASSETS.md.
         NormalTheme is inherited unchanged from values/styles.xml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>
</resources>
